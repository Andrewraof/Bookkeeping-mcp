# Copy this file to .env (or export these as real environment variables)
# and fill in your real Odoo connection details. Never commit a filled-in
# .env file -- it is already ignored by .gitignore.

# Base URL of your Odoo instance (no trailing slash, no /web path).
ODOO_URL=https://your-instance.odoo.com

# Database name.
ODOO_DB=your-database-name

# The Odoo user this server authenticates as. Its access rights (groups,
# record rules, company access) are exactly what this MCP server can do --
# create a dedicated user for this integration rather than reusing an
# admin's personal login, so access can be revoked/audited independently.
ODOO_USERNAME=mcp-integration@yourcompany.com

# An API key for that user (Odoo: user avatar -> My Profile -> Account
# Security -> New API Key). Never the user's real password.
ODOO_API_KEY=

# ── Safety valves (all optional; shown here at their defaults) ──────────
# Deletion (unlink) is off by default -- Odoo has no undo for a deleted
# record, unlike a posted entry, which can always be reversed. Set to
# "true" to allow the odoo_unlink tool to actually delete records.
ODOO_MCP_ALLOW_UNLINK=false

# Posting (action_post) and payment registration. On by default per this
# integration's requested "full control" scope.
ODOO_MCP_ALLOW_POST=true

# Reconciliation of move lines. On by default per this integration's
# requested "full control" scope.
ODOO_MCP_ALLOW_RECONCILE=true

# ── Transport (optional; default shown) ─────────────────────────────────
# "stdio"  -- local process spawned by Claude Desktop/Code. Not reachable
#             over the network; nothing below this line applies.
# "http"   -- streamable-HTTP server, for remote access / ChatGPT.
ODOO_MCP_TRANSPORT=stdio

# ── HTTP transport only (ignored when ODOO_MCP_TRANSPORT=stdio) ─────────
# REQUIRED when using http transport -- the server refuses to start over
# HTTP without this (it has no other access control of its own). Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Callers must send: Authorization: Bearer <this value>
ODOO_MCP_BEARER_TOKEN=

# Bind address. Keep 127.0.0.1 and put a reverse proxy (nginx/Caddy/
# Cloudflare Tunnel) in front for TLS + a real domain, rather than binding
# 0.0.0.0 and exposing this process directly to the internet.
ODOO_MCP_HOST=127.0.0.1
ODOO_MCP_PORT=8000
